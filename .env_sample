# Optional overrides.
#
# The normal setup is `python steam_auth.py`, which stores a refresh token in
# auth.json. You do not need any of the values below for that flow.
#
# The values here are only useful for CI, for a manual token, or as a fallback
# if Steam rejects the session access token for GetOwnedGames.

# Permanent Steam Web API key (owned games fallback).
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your Steam64 ID (optional; derived from auth.json or WEBAPI_TOKEN when possible).
STEAM_ID=

# Manual Steam Store webapi_token (expires after ~24 hours).
# Use only if you do not want to use steam_auth.py.
WEBAPI_TOKEN=

# Optional: path to the auth file created by steam_auth.py.
# STEAM_AUTH_FILE=auth.json
